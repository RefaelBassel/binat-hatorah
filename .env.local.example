# --- Database (Turso) ---
# Local dev: file:local.db (no token needed).
# Production: the new Turso DB for binat-hatorah (NOT the gemara10 one).
TURSO_DATABASE_URL=file:local.db
TURSO_AUTH_TOKEN=

# --- Auth.js ---
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=

# Google OAuth client for the NEW binat-hatorah project (console.cloud.google.com):
# create OAuth client (Web), authorized redirect URI:
#   http://localhost:3000/api/auth/callback/google   (dev)
#   https://<production-domain>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Claude (grading assistance) ---
ANTHROPIC_API_KEY=

# --- Email notifications (provider TBD, e.g. Resend) ---
EMAIL_API_KEY=
